<header class="tour-masthead">
  <div class="tour-container flex items-center justify-between gap-4 py-4">
    <div class="flex items-baseline gap-3">
      <span class="text-2xl font-semibold tracking-tight text-walnut-900">avyoats</span>
      <span class="hidden sm:inline text-sm text-ink-700">Cottonwoods at a glance</span>
    </div>
    <div class="text-right">
      <p class="text-xs uppercase tracking-wide text-ink-700">Last refreshed</p>
      <p class="text-sm font-medium text-ink-900">
        <%= fetched_at.in_time_zone(Avyoats::TIME_ZONE).strftime("%-l:%M %p %Z") %>
      </p>
    </div>
  </div>
</header>
